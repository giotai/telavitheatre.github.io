rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/settings/admin)
        && request.auth.uid == get(/databases/$(database)/documents/settings/admin).data.uid;
    }

    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/admin {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /performances/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /actors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
